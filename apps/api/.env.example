# Backend Environment Variables

# === Frontend Configuration ===
# URL where the frontend is hosted - REQUIRED for OAuth redirects
# Development: http://localhost:3000
# Production: https://sevkiyat.toplumplatformu.com
Auth__FrontendBaseUrl=http://localhost:3000

# === CORS Configuration ===
# Comma-separated list of allowed origins
# Development: http://localhost:3000,http://localhost:3001
# Production: https://sevkiyat.toplumplatformu.com
Cors__AllowedOrigins=http://localhost:3000,http://localhost:3001

# === Database ===
ConnectionStrings__DefaultConnection=Host=localhost;Database=sevkiyat_db;Username=postgres;Password=YOUR_DB_PASSWORD

# === JWT Configuration ===
Jwt__Secret=YOUR_JWT_SECRET_KEY_MIN_32_CHARS
Jwt__Issuer=SevkiyatBildirimApi
Jwt__Audience=SevkiyatBildirimWebApp

# === Google OAuth ===
Authentication__Google__ClientId=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
Authentication__Google__ClientSecret=YOUR_GOOGLE_CLIENT_SECRET

# === Email Configuration ===
Email__FromAddress=noreply@example.com
Email__FromName=Sevkiyat Bildirim Sistemi
Email__SmtpHost=smtp.example.com
Email__SmtpPort=587
Email__SmtpUsername=your@email.com
Email__SmtpPassword=YOUR_SMTP_PASSWORD
Email__EnableSsl=true

# === Magic Link ===
MagicLink__BaseUrl=http://localhost:3000

# === Allowed Admin Users (for development seeding) ===
AllowedUsers__AdminEmails__0=gunesbunyamin004@gmail.com
